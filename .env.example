# SQLite für die lokale Entwicklung. Für Produktion: PostgreSQL (siehe README).
DATABASE_URL="file:./prisma/dev.db"
# Geheimnis für Session-Cookies (beliebiger langer zufälliger String)
AUTH_SECRET="change-me-please-very-long-random"
# Ablageort für hochgeladene Dateien (Scheibenvorlagen)
UPLOAD_DIR="./storage/uploads"
# Erster Super-Admin wird beim Seed angelegt
SEED_ADMIN_EMAIL="admin@example.ch"
SEED_ADMIN_PASSWORD="admin1234"
