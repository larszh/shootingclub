# =============================================================================
# Standchef – Umgebungsvariablen
# Kopieren nach .env und ausfüllen. Leere optionale Werte sind erlaubt.
# =============================================================================

# --- Grundeinstellungen (Pflicht) --------------------------------------------

# MySQL / MariaDB. CloudPanel: Datenbank unter «Databases» anlegen, Host 127.0.0.1.
DATABASE_URL="mysql://standchef:standchef@127.0.0.1:3306/standchef"
# Geheimnis für Session-Cookies, 2FA-Zwischenschritt und verschlüsselte Daten
# (mind. 16 Zeichen, besser 48+; z.B. `openssl rand -base64 48`). Nie ändern, sonst
# sind alle Sitzungen beendet und gespeicherte 2FA-Schlüssel/Zugangsdaten unlesbar.
AUTH_SECRET="change-me-please-very-long-random"
# Öffentliche URL ohne Schrägstrich am Ende (Links in E-Mails, Einladungen, Push).
APP_URL="http://localhost:3000"
# Port des Node-Servers (CloudPanel: gleicher Port wie in der Site-Konfiguration)
PORT=3000
# Ablageort für hochgeladene Dateien (Scheibenvorlagen, Dateiablage, Logos)
UPLOAD_DIR="./storage/uploads"

# --- Datenbank (optional) ----------------------------------------------------

# Grösse des MariaDB-Verbindungspools pro Prozess (Standard 10, max. 100).
DB_POOL=

# --- E-Mail-Versand (SMTP) ---------------------------------------------------
# Ohne SMTP_HOST werden Mails nicht verschickt, sondern in der Warteschlange als
# «übersprungen» (SKIPPED) markiert. Status unter /super/system.

# Mailserver, z.B. mail.infomaniak.com, asmtp.mail.hostpoint.ch, smtp.eu.mailgun.org, smtp.postmarkapp.com
SMTP_HOST=
# Port: 587 (STARTTLS, Standard) oder 465 (SSL, dann SMTP_SECURE=true)
SMTP_PORT=587
# "true" nur für Port 465 (implizites TLS)
SMTP_SECURE=false
# Benutzername und Passwort/API-Token des Mailkontos
SMTP_USER=
SMTP_PASS=
# Absender; die Domain braucht SPF und DKIM (siehe docs/DEPLOY-CLOUDPANEL.md)
MAIL_FROM="Standchef <noreply@standchef.ch>"

# --- Push-Benachrichtigungen (Web Push, optional) -----------------------------
# Schlüssel einmalig erzeugen: npx web-push generate-vapid-keys
# Fehlen sie, wird Push still übersprungen (E-Mails gehen trotzdem raus).
# Den privaten Schlüssel nie leichtfertig wechseln: sonst müssen alle Geräte Push neu einschalten.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontaktadresse für die Push-Dienste (mailto: oder https:)
VAPID_SUBJECT="mailto:info@standchef.ch"

# --- Hintergrund-Jobs ---------------------------------------------------------
# Der Job-Runner (Mailversand, Aufräumen, endgültiges Löschen von Vereinen, Erinnerungen)
# läuft im Node-Prozess. 1 = ausschalten (z.B. auf einer zweiten Instanz oder in Tests).
JOBS_DISABLED=

# --- Chat --------------------------------------------------------------------
# Sicherheitsnetz-Polling des Chat-Streams in ms (Standard 30000, mind. 2000).
# Nur bei mehreren Instanzen tiefer setzen (z.B. 5000).
CHAT_POLL_MS=

# --- Dateiablage (optional) --------------------------------------------------
# 1 = externe Speicher (WebDAV/S3) auch an privaten Adressen und per http:// erlauben
# (nur für Tests/Heimnetz, in Produktion leer lassen).
FILE_STORAGE_ALLOW_PRIVATE_HOSTS=

# --- Reverse Proxy (optional) ------------------------------------------------
# Nur hinter Cloudflare auf 1 setzen (Origin nur für Cloudflare-IPs erreichbar): dann wird CF-Connecting-IP als Besucher-IP verwendet.
TRUST_CLOUDFLARE=

# --- Website-Widgets (optional) ----------------------------------------------
# Wer die Widgets unter /embed/<token>/… per iframe einbinden darf (CSP frame-ancestors).
# Quellen durch Leerzeichen oder Kommas getrennt, z.B. "https://www.sv-muster.ch https://*.muster.ch".
# Leer = "*" (jede Website). 'self' (Vorschau unter /admin/embed) ist immer erlaubt; ist kein Eintrag
# gültig, gilt nur 'self' (Warnung beim Build); 'none' sperrt jedes Einbetten. Wird beim Build gelesen: nach einer Änderung neu bauen (npm run build).
EMBED_FRAME_ANCESTORS=

# --- Online-Zahlung (Payrexx/TWINT, Stripe, Worldline, SumUp) -----------------
# Keine Umgebungsvariablen: jeder Verein trägt seine eigenen Zugangsdaten im Admin ein
# (/admin/bookings/payments bzw. /admin/billing/settings). Sie werden mit AUTH_SECRET
# verschlüsselt gespeichert. Webhook-Adressen bauen auf APP_URL auf:
#   Payrexx: <APP_URL>/api/payments/payrexx/<tenant-id>
#   Stripe:  <APP_URL>/api/payments/stripe/<tenant-id>

# --- Deploy-Skript (scripts/deploy.sh) ---------------------------------------
# Werden vom Deploy-Skript gelesen (auch aus der Shell-Umgebung möglich).
# Ablage der Datenbank-Backups vor jeder Migration (Standard: $HOME/backups/standchef)
BACKUP_DIR=
# Anzahl aufbewahrter Backups (Standard 14)
BACKUP_KEEP=
# 1 = Deploy auch ohne mysqldump/mariadb-dump fortsetzen (nicht empfohlen)
ALLOW_NO_BACKUP=
# Build-Verzeichnis für Updates (Standard: .<projektordner>-release neben dem Projektordner,
# muss auf demselben Dateisystem liegen)
RELEASE_DIR=

# --- Seed (npm run db:seed) --------------------------------------------------
# Super-Admin, wird beim Seed angelegt
SEED_ADMIN_EMAIL="admin@example.ch"
SEED_ADMIN_PASSWORD="admin1234"
