# MySQL / MariaDB. CloudPanel: Datenbank unter «Databases» anlegen, Host 127.0.0.1.
DATABASE_URL="mysql://mouche:mouche@127.0.0.1:3306/mouche"
# Geheimnis für Session-Cookies (langer zufälliger String, z.B. `openssl rand -base64 48`)
AUTH_SECRET="change-me-please-very-long-random"
# Öffentliche URL (für Einladungslinks)
APP_URL="http://localhost:3000"
# Port des Node-Servers (CloudPanel: gleicher Port wie in der Site-Konfiguration)
PORT=3000
# Ablageort für hochgeladene Dateien (Scheibenvorlagen)
UPLOAD_DIR="./storage/uploads"
# Super-Admin, wird beim Seed angelegt
SEED_ADMIN_EMAIL="admin@example.ch"
SEED_ADMIN_PASSWORD="admin1234"
