// Standchef – Datenmodell
// Datenbank: MySQL / MariaDB (CloudPanel-Standard).
// Hinweis: Bewusst ohne Prisma-Enums und Json-Felder, damit das Schema leicht
// auf PostgreSQL portierbar bleibt. Aufzählungen sind als String gespeichert
// und werden in src/lib/*.ts bzw. src/modules/*/types.ts validiert.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Kern: Benutzer, Tenants, Mitgliedschaften, Module
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  isSuperAdmin  Boolean   @default(false)
  locale        String    @default("de")
  street        String?
  zip           String?
  city          String?
  avatarPath    String? // relativ zu UPLOAD_DIR, z.B. avatars/<id>.webp
  themePref     String    @default("system") // system | light | dark
  calendarToken String?   @unique // geheimer Token für iCal-Feed der eigenen Termine
  phone         String?
  birthDate     DateTime? @db.Date // für Alterskategorien (U21, Veteran …) und Jungschützen
  totpSecretEnc String?   @db.Text // AES-256-GCM, gesetzt sobald 2FA aktiviert ist
  totpEnabledAt DateTime?
  passwordSetAt DateTime? // null = Konto per Import/Einladung angelegt, Passwort noch nicht gesetzt
  deletedAt     DateTime? // Konto gelöscht und pseudonymisiert (Rechnungen bleiben 10 Jahre)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions          Session[]
  memberships       Membership[]
  programFavorites  ProgramFavorite[]
  createdPrograms   Program[]                @relation("ProgramCreator")
  createdMatches    Match[]                  @relation("MatchCreator")
  participations    MatchParticipant[]
  targetTemplates   TargetTemplate[]         @relation("TargetOwner")
  targetFavorites   TargetFavorite[]
  bookings          Booking[]
  feeInvoices       FeeInvoice[]
  createdEvents     Event[]                  @relation("EventCreator")
  eventRsvps        EventRsvp[]
  announcements     Announcement[]           @relation("AnnouncementAuthor")
  createdFolders    FileFolder[]             @relation("FolderCreator")
  uploadedFiles     StoredFile[]             @relation("FileUploader")
  chatMemberships   ChatMember[]
  chatMessages      ChatMessage[]            @relation("ChatSender")
  ammoOrders        AmmoOrder[]              @relation("AmmoBuyer")
  ammoIssued        AmmoOrder[]              @relation("AmmoIssuer")
  authTokens        AuthToken[]
  pushSubscriptions PushSubscription[]
  notificationPrefs NotificationPreference[]
  qualifications    Qualification[]          @relation("QualificationHolder")
  shiftAssignments  ShiftAssignment[]
  workLogs          WorkLog[]                @relation("WorkLogUser")
  rangeVisits       RangeVisit[]             @relation("RangeVisitUser")
  weaponLoans       WeaponLoan[]             @relation("WeaponLoanUser")
  bookingSeries     BookingSeries[]
  associationAdmins AssociationAdmin[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tenant {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  kind          String    @default("CLUB") // CLUB | RANGE | PRIVATE
  city          String?
  canton        String?
  joinCode      String    @unique
  logoPath      String? // relativ zu UPLOAD_DIR
  brandColor    String? // Hex, z.B. #d6232d – Akzentfarbe (CI)
  brandColor2   String? // optionale Zweitfarbe für Verläufe/Highlights
  description   String?   @db.Text
  website       String?
  calendarToken String?   @unique // geheimer Token für öffentlichen iCal-Feed (Anlässe)
  defaultLocale String    @default("de") // de | fr | it – Sprache für Rechnungen, Mails, Druck
  joinApproval  Boolean   @default(false) // Beitritt per Code erst nach Freigabe durch Admin (Membership.status PENDING)
  replyToEmail  String? // Antwortadresse für Mails des Vereins
  embedToken    String?   @unique // geheimer Token für Widgets auf der Vereinswebsite
  deletedAt     DateTime? // Löschung beantragt (Soft-Delete); endgültig gelöscht nach purgeAfter
  purgeAfter    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships        Membership[]
  modules            TenantModule[]
  programs           Program[]
  programSettings    ProgramTenantSetting[]
  matches            Match[]
  targetTemplates    TargetTemplate[]
  targetSettings     TargetTenantSetting[]
  bookingSettings    BookingSettings?
  resources          Resource[]
  resourceBlocks     ResourceBlock[]
  bookings           Booking[]
  paymentConfigs     PaymentProviderConfig[]
  invoices           Invoice[]
  billingProfile     BillingProfile?
  feeCategories      FeeCategory[]
  feeRuns            FeeRun[]
  feeInvoices        FeeInvoice[]
  events             Event[]
  announcements      Announcement[]
  storageConfig      StorageConfig?
  fileFolders        FileFolder[]
  storedFiles        StoredFile[]
  chats              ChatConversation[]
  ammoSettings       AmmoSettings?
  ammoProducts       AmmoProduct[]
  ammoOrders         AmmoOrder[]
  invitations        Invitation[]
  households         Household[]
  qualifications     Qualification[]
  qualificationRules QualificationRule[]
  shifts             Shift[]
  workHoursSettings  WorkHoursSettings?
  workLogs           WorkLog[]
  championships      Championship[]
  rangeDays          RangeDay[]
  rangeVisits        RangeVisit[]
  rangeRules         RangeRules[]
  shootingWindows    ShootingWindow[]
  shootingQuotas     ShootingQuota[]
  incidents          Incident[]
  clubWeapons        ClubWeapon[]
  weaponLoans        WeaponLoan[]
  ammoMovements      AmmoStockMovement[]
  courses            Course[]
  liveBoards         LiveBoard[]
  federalYears       FederalYear[]
  accountingSettings AccountingSettings?
  resourceShares     ResourceShare[]         @relation("ShareGuest")
  scoreImports       ScoreImport[]
  kioskProducts      KioskProduct[]
  kioskEntries       KioskEntry[]
  feeInvoiceMembers  FeeInvoiceMember[]
  awardLimits        AwardLimit[]
  weaponSettings     WeaponSettings?
  associations       AssociationMember[]
  bookingSeries      BookingSeries[]
}

model Membership {
  id                     String             @id @default(cuid())
  userId                 String
  tenantId               String
  role                   String             @default("MEMBER") // OWNER | ADMIN | TRAINER | MEMBER
  feeCategoryId          String?
  feeAmountOverrideCents Int? // individueller Beitrag, überschreibt die Kategorie
  memberNumber           String?
  status                 String             @default("ACTIVE") // ACTIVE | PASSIVE | HONORARY | JUNIOR | SUPPORTER | LEFT | PENDING (Beitritt wartet auf Freigabe, kein Zugang)
  joinedAt               DateTime?          @db.Date
  leftAt                 DateTime?          @db.Date
  licenseNumber          String? // Swiss-Shooting-Lizenznummer, vom Verein selbst erfasst
  householdId            String?
  guardianName           String? // gesetzliche Vertretung bei Minderjährigen
  guardianEmail          String?
  guardianPhone          String?
  adminNote              String?            @db.Text // nur für Vorstand sichtbar
  workHoursExempt        Boolean            @default(false)
  createdAt              DateTime           @default(now())
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeCategory            FeeCategory?       @relation(fields: [feeCategoryId], references: [id], onDelete: SetNull)
  household              Household?         @relation(fields: [householdId], references: [id], onDelete: SetNull)
  feeInvoices            FeeInvoice[]
  coveredByInvoices      FeeInvoiceMember[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([householdId])
}

model TenantModule {
  id        String  @id @default(cuid())
  tenantId  String
  moduleKey String // scores | targets | bookings | billing
  enabled   Boolean @default(true)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
}

// ---------------------------------------------------------------------------
// Modul: Punkteerfassung
// ---------------------------------------------------------------------------

model Program {
  id           String   @id @default(cuid())
  tenantId     String? // null = globales Programm (Super-Admin)
  createdById  String?
  name         String
  description  String?  @db.Text
  discipline   String   @default("PISTOL") // PISTOL | RIFLE | AIR_PISTOL | AIR_RIFLE | SHOTGUN | OTHER
  weaponNote   String?
  scoringMode  String   @default("RINGS_INT") // RINGS_INT | RINGS_DECIMAL | HITS
  officialKind String? // OP (Obligatorisch) | FS (Feldschiessen) | QUAL (Qualifikation) | null
  passMinScore Float? // Bestehensgrenze (z.B. Obligatorisch 300 m: 42), konfigurierbar
  passMaxZeros Int? // max. Nuller für Bestanden (z.B. 3)
  stagesJson   String   @db.Text // Array<Stage>, siehe src/modules/scores/types.ts
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant               Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy            User?                  @relation("ProgramCreator", fields: [createdById], references: [id], onDelete: SetNull)
  settings             ProgramTenantSetting[]
  favorites            ProgramFavorite[]
  matches              Match[]
  championshipPrograms ChampionshipProgram[]
  qualificationRules   QualificationRule[]
  awardLimits          AwardLimit[]

  @@index([tenantId])
}

model ProgramTenantSetting {
  id        String  @id @default(cuid())
  programId String
  tenantId  String
  hidden    Boolean @default(false)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([programId, tenantId])
}

model ProgramFavorite {
  id        String   @id @default(cuid())
  userId    String
  programId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
}

model Match {
  id           String    @id @default(cuid())
  tenantId     String
  programId    String
  createdById  String?
  title        String?
  date         DateTime  @default(now())
  locationNote String?
  status       String    @default("OPEN") // OPEN | FINISHED
  clientId     String?   @unique // vom Client erzeugte ID für Offline-Erstellung (idempotente Synchronisierung)
  eventId      String? // optional: gehört zu einem Anlass (z.B. Obligatorisch-Termin)
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program      Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  createdBy    User?              @relation("MatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants MatchParticipant[]
  event        Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@index([eventId])
}

model MatchParticipant {
  id           String    @id @default(cuid())
  matchId      String
  userId       String? // null = Gast
  guestName    String?
  note         String?
  sortOrder    Int       @default(0)
  total        Float? // Gesamttotal, beim Abschliessen bzw. Sync gespeichert (Rangliste ohne shotsJson-Parsing)
  zeros        Int? // Anzahl Nuller
  isOfficial   Boolean   @default(false) // amtliches Resultat (Bundesübung), vom Schützenmeister bestätigt
  attempt      Int? // Versuch Nr. (Obligatorisch)
  passed       Boolean?
  verifiedById String?
  verifiedAt   DateTime?

  match          Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  results        MatchResult[]
  qualifications Qualification[]

  @@index([matchId])
  @@index([userId])
  @@index([userId, isOfficial])
}

model MatchResult {
  id              String    @id @default(cuid())
  participantId   String
  stageIndex      Int
  shotsJson       String    @db.Text // number[]
  total           Float     @default(0)
  clientUpdatedAt DateTime? // Zeitstempel vom Gerät (Offline-Sync, last-write-wins)
  updatedAt       DateTime  @updatedAt

  participant MatchParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, stageIndex])
}

// ---------------------------------------------------------------------------
// Modul: Zielscheiben
// ---------------------------------------------------------------------------

model TargetTemplate {
  id               String   @id @default(cuid())
  tenantId         String? // null = global (Super-Admin) oder privater Upload ohne Tenant
  ownerUserId      String? // gesetzt bei Upload durch Benutzer
  name             String
  description      String?  @db.Text
  subject          String // RINGS_10 | RINGS_5 | GRID | DOTS | SILHOUETTE | DIAMOND | UPLOAD
  paramsJson       String   @db.Text // Objekt TargetParams, wird im Code immer gesetzt
  paperSizes       String   @default("A4,A5,A6")
  filePath         String? // relativ zu UPLOAD_DIR
  mimeType         String?
  sharedWithTenant Boolean  @default(false) // Benutzer-Upload für Tenant freigeben
  isArchived       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant    Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner     User?                 @relation("TargetOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  settings  TargetTenantSetting[]
  favorites TargetFavorite[]

  @@index([tenantId])
  @@index([ownerUserId])
}

model TargetTenantSetting {
  id       String         @id @default(cuid())
  targetId String
  tenantId String
  hidden   Boolean        @default(false)
  target   TargetTemplate @relation(fields: [targetId], references: [id], onDelete: Cascade)
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([targetId, tenantId])
}

model TargetFavorite {
  id       String         @id @default(cuid())
  userId   String
  targetId String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  target   TargetTemplate @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId])
}

// ---------------------------------------------------------------------------
// Modul: Reservationen & Zahlungen
// ---------------------------------------------------------------------------

model BookingSettings {
  id                        String   @id @default(cuid())
  tenantId                  String   @unique
  currency                  String   @default("CHF")
  slotStepMinutes           Int      @default(30)
  durationOptionsJson       String   @db.Text // [{minutes, priceCents}]
  openingHoursJson          String   @db.Text // {"0":[["08:00","12:00"]],...} Schlüssel = Wochentag (0 = So)
  approvalRequired          Boolean  @default(false)
  allowInvoice              Boolean  @default(true)
  allowOnline               Boolean  @default(false)
  onlineProvider            String   @default("NONE") // NONE | STRIPE | WORLDLINE | SUMUP
  lastMinuteDiscountPercent Int      @default(0)
  lastMinuteWindowHours     Int      @default(24)
  minLeadMinutes            Int      @default(60)
  maxAdvanceDays            Int      @default(60)
  cancellationHours         Int      @default(24)
  invoiceDueDays            Int      @default(30)
  invoicePrefix             String   @default("R-")
  invoiceNote               String?  @db.Text
  // Preise pro Person (optional). Die Preistabelle steckt in durationOptionsJson:
  // [{minutes, priceCents, personPrices?: number[] (Index 0 = 1 Person), flatFromPersons?, flatPriceCents?}]
  personPricing             Boolean  @default(false)
  maxPersons                Int      @default(1) // Standard-Höchstzahl Personen pro Buchung
  flatExclusive             Boolean  @default(true) // Pauschalbuchung belegt die ganze Ressource
  capacityPerPerson         Boolean  @default(false) // true: jede Person belegt einen Platz der Kapazität
  updatedAt                 DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Resource {
  id                  String   @id @default(cuid())
  tenantId            String
  name                String
  description         String?  @db.Text
  kind                String   @default("LANE") // RANGE | LANE | ROOM | OTHER
  capacity            Int      @default(1) // gleichzeitige Buchungen bzw. Plätze
  maxPersons          Int? // Abweichung von BookingSettings.maxPersons
  durationOptionsJson String?  @db.Text // optionale Abweichung von den Tenant-Optionen
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  blocks          ResourceBlock[]
  rangeDays       RangeDay[]
  shootingWindows ShootingWindow[]
  shootingQuotas  ShootingQuota[]
  shares          ResourceShare[]
  bookingSeries   BookingSeries[]

  @@index([tenantId])
}

model ResourceBlock {
  id         String   @id @default(cuid())
  tenantId   String
  resourceId String? // null = alle Ressourcen des Tenants
  startsAt   DateTime
  endsAt     DateTime
  reason     String?
  createdAt  DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
}

model Booking {
  id              String    @id @default(cuid())
  tenantId        String
  resourceId      String
  userId          String?
  startsAt        DateTime
  endsAt          DateTime
  durationMinutes Int
  viaTenantId     String? // Buchung durch Mitglied eines Partnervereins (gemeinsame Anlage)
  persons         Int       @default(1) // Anzahl Personen
  units           Int       @default(1) // belegte Kapazitätseinheiten (Pauschal exklusiv = Kapazität der Ressource)
  isFlatRate      Boolean   @default(false) // Pauschalpreis (ganze Ressource)
  status          String    @default("CONFIRMED") // PENDING | CONFIRMED | REJECTED | CANCELLED
  paymentMethod   String    @default("NONE") // NONE | INVOICE | ONLINE
  paymentStatus   String    @default("NOT_REQUIRED") // NOT_REQUIRED | UNPAID | PENDING | PAID | FAILED | REFUNDED
  basePriceCents  Int       @default(0)
  discountCents   Int       @default(0)
  discountReason  String?
  totalCents      Int       @default(0)
  currency        String    @default("CHF")
  note            String?
  adminNote       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  paidAt          DateTime?
  refundedAt      DateTime? // Online-Zahlung zurückerstattet (paymentStatus REFUNDED)
  seriesId        String? // gehört zu einer Serienbuchung
  reminderSentAt  DateTime? // Erinnerungsmail verschickt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource Resource       @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  payments Payment[]
  invoice  Invoice?
  series   BookingSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@index([tenantId, startsAt])
  @@index([resourceId, startsAt])
  @@index([userId])
  @@index([seriesId])
}

// Wiederkehrende Reservation (z.B. jeden Dienstag 18–20 Uhr); erzeugt einzelne Booking-Zeilen mit seriesId
model BookingSeries {
  id         String   @id @default(cuid())
  tenantId   String
  resourceId String
  userId     String?
  weekdays   String // CSV ISO-Wochentage 1=Mo … 7=So, z.B. "2" oder "1,3"
  startTime  String // HH:mm, Europe/Zurich
  endTime    String // HH:mm, Europe/Zurich
  fromDate   DateTime @db.Date
  untilDate  DateTime @db.Date
  persons    Int      @default(1)
  note       String?
  status     String   @default("ACTIVE") // ACTIVE | CANCELLED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([tenantId, status])
  @@index([resourceId])
  @@index([userId])
}

model Payment {
  id           String   @id @default(cuid())
  bookingId    String? // Reservation
  feeInvoiceId String? // Mitgliederbeitrag / Ersatzabgabe online bezahlt
  tenantId     String? // für Zahlungen ohne Reservation
  provider     String // STRIPE | WORLDLINE | SUMUP
  providerRef  String // Checkout-Session / Token / Checkout-ID
  status       String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  amountCents  Int
  currency     String
  detailsJson  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  booking    Booking?    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  feeInvoice FeeInvoice? @relation(fields: [feeInvoiceId], references: [id], onDelete: Cascade)

  @@index([feeInvoiceId])
  @@index([bookingId])
  @@index([providerRef])
}

model PaymentProviderConfig {
  id             String   @id @default(cuid())
  tenantId       String
  provider       String // STRIPE | WORLDLINE | SUMUP
  enabled        Boolean  @default(false)
  credentialsEnc String   @db.Text // AES-256-GCM, siehe src/lib/crypto.ts
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
}

model Invoice {
  id          String    @id @default(cuid())
  tenantId    String
  bookingId   String    @unique
  number      String
  issuedAt    DateTime  @default(now())
  dueAt       DateTime
  status      String    @default("OPEN") // OPEN | PAID | CANCELLED
  amountCents Int
  currency    String
  reference   String? // QR-Referenz (27 Stellen) bei QR-IBAN, sonst null
  paidAt      DateTime?
  cancelledAt DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
}

// ---------------------------------------------------------------------------
// Rechnungsprofil (gemeinsam für Reservationen und Mitgliederbeiträge)
// ---------------------------------------------------------------------------

model BillingProfile {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  payeeName         String?
  payeeStreet       String?
  payeeZip          String?
  payeeCity         String?
  iban              String?
  onlineFeeProvider String   @default("NONE") // NONE | STRIPE | WORLDLINE | SUMUP | PAYREXX – Online-Zahlung von Beiträgen
  currency          String   @default("CHF")
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Modul: Mitgliederbeiträge
// ---------------------------------------------------------------------------

model FeeCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  amountCents Int      @default(0)
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invoices    FeeInvoice[]

  @@index([tenantId])
}

model FeeRun {
  id            String   @id @default(cuid())
  tenantId      String
  year          Int
  title         String
  dueAt         DateTime
  invoicePrefix String   @default("MB-")
  dueDays       Int      @default(30)
  note          String?  @db.Text
  createdAt     DateTime @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices FeeInvoice[]

  @@unique([tenantId, year])
}

model FeeInvoice {
  id            String    @id @default(cuid())
  tenantId      String
  runId         String?
  membershipId  String?
  userId        String?
  categoryId    String?
  year          Int
  number        String
  memberName    String
  memberEmail   String?
  memberAddress String? // mehrzeilig, Snapshot
  categoryName  String
  amountCents   Int
  currency      String    @default("CHF")
  issuedAt      DateTime  @default(now())
  dueAt         DateTime
  status        String    @default("OPEN") // OPEN | PAID | CANCELLED
  reference     String? // QR-Referenz (27 Stellen) bei QR-IBAN, sonst null
  paidAt        DateTime?
  paymentNote   String?
  remindedAt    DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run        FeeRun?            @relation(fields: [runId], references: [id], onDelete: SetNull)
  membership Membership?        @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  category   FeeCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments   Payment[]
  members    FeeInvoiceMember[]

  @@unique([tenantId, number])
  @@index([tenantId, year, status])
  @@index([userId])
}

// Mitglieder, die eine (Haushalts-)Beitragsrechnung abdeckt
model FeeInvoiceMember {
  id           String   @id @default(cuid())
  invoiceId    String
  membershipId String
  tenantId     String
  createdAt    DateTime @default(now())

  invoice    FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, membershipId])
  @@index([membershipId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Modul: Anlässe & Mitteilungen
// ---------------------------------------------------------------------------

model Event {
  id           String    @id @default(cuid())
  tenantId     String
  createdById  String?
  title        String
  description  String?   @db.Text
  kind         String    @default("TRAINING") // TRAINING | COMPETITION | OBLIGATORY | MEETING | SOCIAL | WORK | OTHER
  startsAt     DateTime
  endsAt       DateTime?
  allDay       Boolean   @default(false)
  location     String?
  rsvpEnabled  Boolean   @default(true)
  capacity     Int?
  rsvpDeadline DateTime?
  isCancelled  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  rsvps          EventRsvp[]
  matches        Match[]
  shifts         Shift[]
  courseSessions CourseSession[]

  @@index([tenantId, startsAt])
}

model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String // YES | NO | MAYBE
  guests    Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Announcement {
  id        String    @id @default(cuid())
  tenantId  String
  authorId  String?
  title     String
  body      String    @db.Text
  pinned    Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User?  @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------------
// Modul: Dateiablage (lokal, S3-kompatibel oder Nextcloud/WebDAV)
// ---------------------------------------------------------------------------

model StorageConfig {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  provider       String   @default("LOCAL") // LOCAL | S3 | WEBDAV
  credentialsEnc String?  @db.Text // AES-256-GCM (src/lib/crypto.ts): S3 endpoint/region/bucket/keys, WebDAV url/user/app password
  quotaMb        Int? // optionales Speicherlimit pro Verein
  maxFileMb      Int      @default(25)
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model FileFolder {
  id          String   @id @default(cuid())
  tenantId    String
  parentId    String?
  name        String
  minRole     String   @default("MEMBER") // wer sieht den Ordner: MEMBER | TRAINER | ADMIN | OWNER
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    FileFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  FileFolder[] @relation("FolderTree")
  createdBy User?        @relation("FolderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  files     StoredFile[]

  @@index([tenantId, parentId])
}

model StoredFile {
  id           String   @id @default(cuid())
  tenantId     String
  folderId     String?
  name         String
  mimeType     String
  sizeBytes    Int
  provider     String // LOCAL | S3 | WEBDAV – wo die Datei tatsächlich liegt
  storageKey   String   @db.Text
  uploadedById String?
  context      String   @default("FILES") // FILES | CHAT
  createdAt    DateTime @default(now())

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder     FileFolder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  messages   ChatMessage[]

  @@index([tenantId, folderId])
}

// ---------------------------------------------------------------------------
// Modul: Chat (1:1 und Gruppen, pro Verein)
// ---------------------------------------------------------------------------

model ChatConversation {
  id            String    @id @default(cuid())
  tenantId      String
  kind          String // DIRECT | GROUP
  title         String?
  directKey     String?   @unique // DIRECT: "<tenantId>:<userIdA>:<userIdB>" sortiert, verhindert Duplikate
  createdById   String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members  ChatMember[]
  messages ChatMessage[]

  @@index([tenantId, lastMessageAt])
}

model ChatMember {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  role           String    @default("MEMBER") // ADMIN | MEMBER
  lastReadAt     DateTime?
  muted          Boolean   @default(false)
  joinedAt       DateTime  @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String?
  body           String    @db.Text
  fileId         String?
  clientId       String?   @unique // idempotentes Senden (auch offline nachgereicht)
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?            @relation("ChatSender", fields: [senderId], references: [id], onDelete: SetNull)
  file         StoredFile?      @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Modul: Munition (Verkauf nur auf Rechnung)
// ---------------------------------------------------------------------------

model AmmoSettings {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  onSiteOnly        Boolean  @default(true) // Abgabe nur zum sofortigen Verbrauch auf dem Platz
  requireIdCheck    Boolean  @default(true) // Ausgabe nur mit bestätigter Berechtigungsprüfung
  approvalRequired  Boolean  @default(false) // Bestellungen zuerst freigeben
  invoicePrefix     String   @default("MU-")
  invoiceDueDays    Int      @default(30)
  maxRoundsPerOrder Int? // optionales Limit pro Bestellung
  note              String?  @db.Text // Hinweis für Mitglieder (z.B. rechtliche Hinweise)
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AmmoProduct {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  caliber       String
  manufacturer  String?
  description   String?  @db.Text
  unitLabel     String   @default("Schachtel") // Verkaufseinheit
  roundsPerUnit Int      @default(50)
  priceCents    Int // Preis pro Einheit
  stockUnits    Int? // null = Bestand nicht geführt
  fundingType   String   @default("COMMERCIAL") // FEDERAL_FREE (Bund, gratis) | SUBSIDIZED | COMMERCIAL
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     AmmoOrderItem[]
  movements AmmoStockMovement[]

  @@index([tenantId])
}

model AmmoOrder {
  id              String    @id @default(cuid())
  tenantId        String
  userId          String?
  status          String    @default("ORDERED") // ORDERED | APPROVED | ISSUED | CANCELLED
  totalCents      Int
  currency        String    @default("CHF")
  note            String?
  idChecked       Boolean   @default(false)
  issuedAt        DateTime?
  issuedById      String?
  invoiceNumber   String?
  reference       String? // QR-Referenz bei QR-IBAN
  invoiceIssuedAt DateTime?
  dueAt           DateTime?
  paymentStatus   String    @default("UNPAID") // UNPAID | PAID | CANCELLED
  paidAt          DateTime?
  paymentNote     String?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?           @relation("AmmoBuyer", fields: [userId], references: [id], onDelete: SetNull)
  issuedBy User?           @relation("AmmoIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  items    AmmoOrderItem[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([userId])
}

model AmmoOrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String?
  productName    String
  caliber        String
  unitLabel      String
  roundsPerUnit  Int
  quantity       Int
  unitPriceCents Int
  totalCents     Int

  order   AmmoOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product AmmoProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Plattform: Audit-Log, Mails, Jobs, Tokens, Push
// ---------------------------------------------------------------------------

// Bewusst ohne Relationen: Einträge überleben das Löschen von Tenant und Benutzer.
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  actorId   String?
  actorName String?
  action    String // z.B. member.role.change, tenant.delete.request, fee.run.create
  entity    String?
  entityId  String?
  detail    String?  @db.Text // kurzer Text ohne heikle Daten
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  kind      String // RESET | INVITE | VERIFY
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  name        String?
  role        String    @default("MEMBER")
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
}

model MailMessage {
  id        String    @id @default(cuid())
  tenantId  String?
  kind      String? // reset | invite | fee-invoice | reminder | booking | shift | …
  toEmail   String
  toName    String?
  replyTo   String?
  subject   String
  html      String    @db.MediumText
  text      String    @db.MediumText
  status    String    @default("QUEUED") // QUEUED | SENDING | SENT | FAILED | SKIPPED
  attempts  Int       @default(0)
  lastError String?   @db.Text
  sendAfter DateTime  @default(now())
  sentAt    DateTime?
  dedupeKey String?   @unique // verhindert doppelte Erinnerungen
  createdAt DateTime  @default(now())

  @@index([status, sendAfter])
  @@index([tenantId, createdAt])
}

model JobLock {
  name        String    @id
  lockedUntil DateTime?
  lastRunAt   DateTime?
  lastStatus  String?
  lastError   String?   @db.Text
}

model PushSubscription {
  id           String    @id @default(cuid())
  userId       String
  endpointHash String    @unique // sha256 des Endpoints (Endpoints sind länger als 191 Zeichen)
  endpoint     String    @db.Text
  p256dh       String
  auth         String
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id      String  @id @default(cuid())
  userId  String
  channel String // EMAIL | PUSH
  topic   String // chat | announcements | bookings | invoices | shifts | events | reminders
  enabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, topic])
}

// ---------------------------------------------------------------------------
// Mitglieder: Haushalte, Qualifikationen
// ---------------------------------------------------------------------------

model Household {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  payerUserId String? // wer die Familienrechnung erhält
  createdAt   DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([tenantId])
}

model Qualification {
  id                  String    @id @default(cuid())
  tenantId            String
  userId              String
  kind                String // SCHUETZENMEISTER | JS_LEITER | JPLUS_LEITER | FIRST_AID | RANGE_OFFICER | INSTRUCTOR | WEAPON_QUAL | OTHER
  label               String? // Freitext, z.B. «Pistole 25 m Einsatzqualifikation»
  number              String?
  validFrom           DateTime? @db.Date
  validUntil          DateTime? @db.Date
  verifiedById        String?
  sourceParticipantId String? // Qualifikationsschiessen, aus dem diese Qualifikation stammt
  note                String?
  createdAt           DateTime  @default(now())

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User              @relation("QualificationHolder", fields: [userId], references: [id], onDelete: Cascade)
  source MatchParticipant? @relation(fields: [sourceParticipantId], references: [id], onDelete: SetNull)

  @@index([tenantId, kind])
  @@index([userId])
}

// Qualifikationsschiessen (Polizei, Sicherheitsfirmen, Vereinsintern)
model QualificationRule {
  id                String   @id @default(cuid())
  tenantId          String
  programId         String
  name              String
  kind              String   @default("WEAPON_QUAL")
  passScore         Float
  maxZeros          Int?
  validityMonths    Int      @default(12)
  requireInstructor Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Helfereinsätze und Arbeitsstunden
// ---------------------------------------------------------------------------

model Shift {
  id                    String   @id @default(cuid())
  tenantId              String
  eventId               String?
  title                 String
  startsAt              DateTime
  endsAt                DateTime
  capacity              Int      @default(1)
  requiredQualification String? // Qualification.kind, mind. eine Person muss sie haben
  hoursCredit           Float? // angerechnete Stunden (Standard: Dauer)
  note                  String?
  createdAt             DateTime @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event       Event?            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments ShiftAssignment[]

  @@index([tenantId, startsAt])
}

model ShiftAssignment {
  id            String   @id @default(cuid())
  shiftId       String
  userId        String
  status        String   @default("ASSIGNED") // ASSIGNED | DONE | NO_SHOW
  hours         Float?
  confirmedById String?
  createdAt     DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
  @@index([userId])
}

model WorkHoursSettings {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  enabled                 Boolean  @default(false)
  requiredHours           Float    @default(0)
  ratePerMissingHourCents Int      @default(0) // Ersatzabgabe pro fehlende Stunde
  appliesToStatuses       String   @default("ACTIVE") // CSV aus Membership.status
  proRata                 Boolean  @default(false) // Soll anteilig bei Ein-/Austritt im Jahr
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model WorkLog {
  id           String    @id @default(cuid())
  tenantId     String
  userId       String
  date         DateTime  @db.Date
  hours        Float
  description  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("WorkLogUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Jahresmeisterschaft
// ---------------------------------------------------------------------------

model Championship {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  year           Int
  startsOn       DateTime @db.Date
  endsOn         DateTime @db.Date
  bestOf         Int? // pro Programm zählen die besten N Resultate (null = alle)
  officialOnly   Boolean  @default(false) // nur bestätigte Resultate
  categoriesText String?  @db.Text // eine Kategorie pro Zeile: «Name;minAlter;maxAlter;Bonus»
  rulesText      String?  @db.Text
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programs ChampionshipProgram[]

  @@index([tenantId, year])
}

model ChampionshipProgram {
  id             String  @id @default(cuid())
  championshipId String
  programId      String
  required       Boolean @default(false)
  weight         Float   @default(1)
  maxCount       Int? // überschreibt bestOf für dieses Programm

  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  program      Program      @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([championshipId, programId])
}

// ---------------------------------------------------------------------------
// Standbetrieb: Standbuch, Check-in, Schiesszeiten, Vorfälle
// ---------------------------------------------------------------------------

model RangeDay {
  id          String    @id @default(cuid())
  tenantId    String
  resourceId  String? // Anlage (null = ganze Anlage)
  date        DateTime  @db.Date
  dutyUserId  String? // Standchef / Schützenmeister des Tages
  dutyName    String?
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  usedAm      Boolean   @default(false) // Schiesshalbtag Vormittag
  usedPm      Boolean   @default(false) // Nachmittag
  usedEvening Boolean   @default(false) // Abend
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource      Resource?           @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  visits        RangeVisit[]
  ammoMovements AmmoStockMovement[]

  @@index([tenantId, date])
}

model RangeVisit {
  id              String    @id @default(cuid())
  tenantId        String
  rangeDayId      String?
  userId          String? // null = Gast
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  guestBirthYear  Int?
  guestIdChecked  Boolean   @default(false)
  hostUserId      String? // betreuendes Mitglied bei Gästen
  lane            String?
  discipline      String?
  checkedInAt     DateTime  @default(now())
  checkedOutAt    DateTime?
  clubWeaponId    String?
  rulesId         String? // akzeptierte Standordnung (Version)
  rulesAcceptedAt DateTime?
  clientId        String?   @unique // Offline-Check-in
  note            String?
  createdAt       DateTime  @default(now())

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rangeDay RangeDay?   @relation(fields: [rangeDayId], references: [id], onDelete: SetNull)
  user     User?       @relation("RangeVisitUser", fields: [userId], references: [id], onDelete: SetNull)
  rules    RangeRules? @relation(fields: [rulesId], references: [id], onDelete: SetNull)

  @@index([tenantId, checkedInAt])
  @@index([userId])
}

model RangeRules {
  id          String    @id @default(cuid())
  tenantId    String
  version     Int
  title       String
  body        String    @db.Text
  isActive    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visits      RangeVisit[]
  acceptances RulesAcceptance[]

  @@unique([tenantId, version])
}

model RulesAcceptance {
  id         String   @id @default(cuid())
  rulesId    String
  userId     String
  acceptedAt DateTime @default(now())

  rules RangeRules @relation(fields: [rulesId], references: [id], onDelete: Cascade)

  @@unique([rulesId, userId])
}

// Bewilligte Schiesszeiten pro Anlage (Wochenplan)
model ShootingWindow {
  id          String  @id @default(cuid())
  tenantId    String
  resourceId  String?
  weekday     Int // 0 = So … 6 = Sa
  startMinute Int // Minuten ab Mitternacht
  endMinute   Int
  note        String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Kontingent Schiesshalbtage pro Jahr (aus Lärmbeurteilung/Bewilligung)
model ShootingQuota {
  id          String  @id @default(cuid())
  tenantId    String
  resourceId  String?
  year        Int
  maxHalfDays Int
  note        String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, resourceId, year])
}

model Incident {
  id           String   @id @default(cuid())
  tenantId     String
  occurredAt   DateTime
  kind         String   @default("NEAR_MISS") // ACCIDENT | NEAR_MISS | DAMAGE | OTHER
  severity     String   @default("LOW") // LOW | MEDIUM | HIGH
  location     String?
  description  String   @db.Text
  persons      String?  @db.Text
  measures     String?  @db.Text
  status       String   @default("OPEN") // OPEN | CLOSED
  reportedById String?
  clientId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
}

// ---------------------------------------------------------------------------
// Vereinswaffen und Munitionskontrolle
// ---------------------------------------------------------------------------

model ClubWeapon {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  discipline        String?
  manufacturer      String?
  model             String?
  caliber           String?
  serialNumber      String?
  status            String    @default("AVAILABLE") // AVAILABLE | LOANED | SERVICE | BLOCKED | RETIRED
  shotCount         Int       @default(0)
  serviceEveryShots Int?
  nextServiceAt     DateTime? @db.Date
  notes             String?   @db.Text
  blockReason       String? // Grund bei status BLOCKED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loans    WeaponLoan[]
  services WeaponService[]

  @@index([tenantId])
}

model WeaponLoan {
  id           String    @id @default(cuid())
  tenantId     String
  weaponId     String
  userId       String?
  borrowerName String?
  isMinor      Boolean   @default(false)
  onSiteOnly   Boolean   @default(true) // nur am Stand unter Aufsicht
  loanedAt     DateTime  @default(now())
  dueAt        DateTime?
  returnedAt   DateTime?
  shots        Int?
  issuedById   String?
  reportDueAt  DateTime? // Meldefrist Kanton bei Minderjährigen (prüfen)
  reportedAt   DateTime?
  note         String?

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  weapon ClubWeapon @relation(fields: [weaponId], references: [id], onDelete: Cascade)
  user   User?      @relation("WeaponLoanUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, loanedAt])
  @@index([weaponId])
}

model WeaponService {
  id        String   @id @default(cuid())
  weaponId  String
  date      DateTime @db.Date
  kind      String   @default("SERVICE") // SERVICE | REPAIR | INSPECTION
  note      String?
  costCents Int?
  byName    String?
  createdAt DateTime @default(now())

  weapon ClubWeapon @relation(fields: [weaponId], references: [id], onDelete: Cascade)

  @@index([weaponId])
}

model AmmoStockMovement {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  kind        String // RECEIPT | ISSUE | SALE | RETURN | INVENTORY | CORRECTION
  units       Int // positiv = Zugang, negativ = Abgang
  date        DateTime @default(now())
  rangeDayId  String?
  orderId     String?
  source      String? // z.B. «Bund (Lieferschein 123)»
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  AmmoProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  rangeDay RangeDay?   @relation(fields: [rangeDayId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Kurse (Jungschützen, J+S, Ausbildung, Polizei)
// ---------------------------------------------------------------------------

model Course {
  id                 String    @id @default(cuid())
  tenantId           String
  kind               String    @default("JUNGSCHUETZEN") // JUNGSCHUETZEN | JS | TRAINING | POLICE | OTHER
  name               String
  year               Int
  startsOn           DateTime? @db.Date
  endsOn             DateTime? @db.Date
  leaderUserId       String?
  minParticipants    Int?
  requiredProgramIds String?   @db.Text // CSV von Program.id (Pflichtprogramme)
  notes              String?   @db.Text
  status             String    @default("PLANNED") // PLANNED | RUNNING | CLOSED
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants CourseParticipant[]
  sessions     CourseSession[]

  @@index([tenantId, year])
}

model CourseParticipant {
  id            String    @id @default(cuid())
  courseId      String
  userId        String?
  firstName     String
  lastName      String
  birthDate     DateTime? @db.Date
  email         String?
  phone         String?
  street        String?
  zip           String?
  city          String?
  guardianName  String?
  guardianEmail String?
  guardianPhone String?
  clubWeaponId  String?
  status        String    @default("REGISTERED") // REGISTERED | ACTIVE | COMPLETED | DROPPED
  note          String?
  createdAt     DateTime  @default(now())

  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendance CourseAttendance[]
  results    CourseResult[]

  @@index([courseId])
}

model CourseSession {
  id       String    @id @default(cuid())
  courseId String
  eventId  String?
  title    String
  startsAt DateTime
  endsAt   DateTime?

  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  event      Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  attendance CourseAttendance[]

  @@index([courseId, startsAt])
}

model CourseAttendance {
  id            String  @id @default(cuid())
  sessionId     String
  participantId String
  present       Boolean @default(true)
  note          String?

  session     CourseSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant CourseParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, participantId])
}

model CourseResult {
  id                 String   @id @default(cuid())
  participantId      String
  programId          String?
  label              String // Programmname (Snapshot)
  score              Float?
  passed             Boolean  @default(false)
  date               DateTime @db.Date
  matchParticipantId String?
  createdAt          DateTime @default(now())

  participant CourseParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Live-Rangliste (TV/Beamer im Schützenhaus)
// ---------------------------------------------------------------------------

model LiveBoard {
  id           String    @id @default(cuid())
  tenantId     String
  token        String    @unique
  title        String
  programId    String?
  eventId      String?
  date         DateTime? @db.Date // nur Durchgänge dieses Tages (null = heute)
  showDecimals Boolean   @default(false)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Bundesübungen: Fristen und Notizen pro Jahr
// ---------------------------------------------------------------------------

model FederalYear {
  id                   String    @id @default(cuid())
  tenantId             String
  year                 Int
  registrationDeadline DateTime? @db.Date // Meldung der Schiesstage (z.B. via SAT-Admin)
  shootingDeadline     DateTime? @db.Date // letzter Tag für das Obligatorisch
  reportDeadline       DateTime? @db.Date // Abschluss/Meldung der Resultate
  notes                String?   @db.Text
  updatedAt            DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year])
}

// ---------------------------------------------------------------------------
// Buchhaltung, gemeinsame Anlagen, Resultat-Import
// ---------------------------------------------------------------------------

model AccountingSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  bankAccount        String   @default("1020") // Bank / Post
  receivableAccount  String   @default("1100") // Debitoren
  feeAccount         String   @default("3000") // Mitgliederbeiträge
  bookingAccount     String   @default("3400") // Standmiete / Reservationen
  ammoAccount        String   @default("3200") // Munitionsverkauf
  workFeeAccount     String   @default("3010") // Ersatzabgabe Arbeitsstunden
  feesExpenseAccount String   @default("6940") // Zahlungsgebühren
  cashAccount        String   @default("1000") // Kasse (Barzahlungen)
  kioskAccount       String   @default("3600") // Ertrag Schützenstube
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Anlage eines Vereins, die ein Partnerverein mitbenutzt
model ResourceShare {
  id                 String   @id @default(cuid())
  resourceId         String
  guestTenantId      String
  canBook            Boolean  @default(true)
  priceFactorPercent Int      @default(100)
  note               String?
  createdAt          DateTime @default(now())

  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  guestTenant Tenant   @relation("ShareGuest", fields: [guestTenantId], references: [id], onDelete: Cascade)

  @@unique([resourceId, guestTenantId])
  @@index([guestTenantId])
}

model ScoreImport {
  id          String   @id @default(cuid())
  tenantId    String
  createdById String?
  format      String // CSV | MEYTON | SIUS
  fileName    String
  fileHash    String
  rows        Int      @default(0)
  matchIds    String?  @db.Text // CSV von Match.id
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fileHash])
}

// Kasse Schützenstube: Konsumationen aufschreiben und periodisch verrechnen
model KioskProduct {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  category   String? // Getränke, Snacks, Scheiben …
  priceCents Int
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries KioskEntry[]

  @@index([tenantId])
}

model KioskEntry {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String?
  guestName       String?
  productId       String?
  productName     String
  quantity        Int      @default(1)
  unitPriceCents  Int
  totalCents      Int
  createdById     String?
  clientId        String?  @unique
  billedInvoiceId String? // FeeInvoice.id, sobald verrechnet
  paidCash        Boolean  @default(false)
  createdAt       DateTime @default(now())

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product KioskProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, billedInvoiceId])
}

// ---------------------------------------------------------------------------
// Welle D: Auszeichnungslimiten, Waffen-Einstellungen, Kantonalverband
// ---------------------------------------------------------------------------

// Kranz-/Auszeichnungslimite pro Programm, Jahr und Kategorie (z.B. Feldschiessen E, U21, Veteran)
model AwardLimit {
  id        String   @id @default(cuid())
  tenantId  String
  programId String
  year      Int
  category  String // Alters-/Leistungskategorie, frei (z.B. "E", "U21", "V", "SV")
  minScore  Float // gleiche Einheit wie MatchParticipant.total
  award     String // z.B. "Kranz", "Anerkennungskarte"
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([tenantId, programId, year])
  @@index([programId])
}

model WeaponSettings {
  id                       String   @id @default(cuid())
  tenantId                 String   @unique
  minorReportDays          Int      @default(30) // Meldefrist Ausleihe an Minderjährige (DEFAULT_MINOR_REPORT_DAYS)
  serviceEveryShotsDefault Int? // Standard-Wartungsintervall für neue Waffen
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Kantonal-/Regionalverband: vereinsübergreifende Sicht. Verwaltung durch Super-Admin und AssociationAdmin
// (ausserhalb der Tenant-Rollen).
model Association {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique @db.VarChar(8) // Beitrittscode für Vereine
  region    String? // z.B. Kanton
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  members AssociationMember[]
  admins  AssociationAdmin[]
}

model AssociationMember {
  id            String    @id @default(cuid())
  associationId String
  tenantId      String
  status        String    @default("PENDING") // PENDING | APPROVED | REVOKED
  shareNames    Boolean   @default(false) // Namen der Schützen teilen (sonst nur Zahlen)
  consentAt     DateTime? // Zustimmung des Vereins zur Datenweitergabe
  approvedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([associationId, tenantId])
  @@index([tenantId])
}

model AssociationAdmin {
  id            String   @id @default(cuid())
  associationId String
  userId        String
  role          String   @default("ADMIN") // ADMIN | VIEWER
  createdAt     DateTime @default(now())

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([associationId, userId])
  @@index([userId])
}
