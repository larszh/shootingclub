// Mouche – Datenmodell
// Hinweis: Bewusst ohne Prisma-Enums und Json-Felder, damit das Schema 1:1
// zwischen SQLite (Entwicklung) und PostgreSQL (Produktion) portierbar bleibt.
// Aufzählungen sind als String gespeichert und werden in src/lib/*.ts validiert.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Kern: Benutzer, Tenants, Mitgliedschaften, Module
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isSuperAdmin Boolean  @default(false)
  locale       String   @default("de")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions         Session[]
  memberships      Membership[]
  programFavorites ProgramFavorite[]
  createdPrograms  Program[]           @relation("ProgramCreator")
  createdMatches   Match[]             @relation("MatchCreator")
  participations   MatchParticipant[]
  targetTemplates  TargetTemplate[]    @relation("TargetOwner")
  targetFavorites  TargetFavorite[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  kind      String   @default("CLUB") // CLUB | RANGE | PRIVATE
  city      String?
  canton    String?
  joinCode  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  modules         TenantModule[]
  programs        Program[]
  programSettings ProgramTenantSetting[]
  matches         Match[]
  targetTemplates TargetTemplate[]
  targetSettings  TargetTenantSetting[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("MEMBER") // OWNER | ADMIN | TRAINER | MEMBER
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model TenantModule {
  id        String  @id @default(cuid())
  tenantId  String
  moduleKey String  // scores | targets | bookings | billing
  enabled   Boolean @default(true)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
}

// ---------------------------------------------------------------------------
// Modul: Punkteerfassung
// ---------------------------------------------------------------------------

model Program {
  id          String   @id @default(cuid())
  tenantId    String?  // null = globales Programm (Super-Admin)
  createdById String?
  name        String
  description String?
  discipline  String   @default("PISTOL") // PISTOL | RIFLE | AIR_PISTOL | AIR_RIFLE | SHOTGUN | OTHER
  weaponNote  String?
  scoringMode String   @default("RINGS_INT") // RINGS_INT | RINGS_DECIMAL | HITS
  stagesJson  String   // Array<Stage>, siehe src/modules/scores/types.ts
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?                  @relation("ProgramCreator", fields: [createdById], references: [id], onDelete: SetNull)
  settings  ProgramTenantSetting[]
  favorites ProgramFavorite[]
  matches   Match[]

  @@index([tenantId])
}

model ProgramTenantSetting {
  id        String  @id @default(cuid())
  programId String
  tenantId  String
  hidden    Boolean @default(false)
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([programId, tenantId])
}

model ProgramFavorite {
  id        String   @id @default(cuid())
  userId    String
  programId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
}

model Match {
  id           String   @id @default(cuid())
  tenantId     String
  programId    String
  createdById  String?
  title        String?
  date         DateTime @default(now())
  locationNote String?
  status       String   @default("OPEN") // OPEN | FINISHED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program      Program            @relation(fields: [programId], references: [id], onDelete: Restrict)
  createdBy    User?              @relation("MatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants MatchParticipant[]

  @@index([tenantId, date])
}

model MatchParticipant {
  id        String  @id @default(cuid())
  matchId   String
  userId    String? // null = Gast
  guestName String?
  note      String?
  sortOrder Int     @default(0)

  match   Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  results MatchResult[]

  @@index([matchId])
  @@index([userId])
}

model MatchResult {
  id            String   @id @default(cuid())
  participantId String
  stageIndex    Int
  shotsJson     String   // number[]
  total         Float    @default(0)
  updatedAt     DateTime @updatedAt

  participant MatchParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, stageIndex])
}

// ---------------------------------------------------------------------------
// Modul: Zielscheiben
// ---------------------------------------------------------------------------

model TargetTemplate {
  id            String   @id @default(cuid())
  tenantId      String?  // null = global (Super-Admin) oder privater Upload ohne Tenant
  ownerUserId   String?  // gesetzt bei Upload durch Benutzer
  name          String
  description   String?
  subject       String   // RINGS_10 | RINGS_5 | GRID | DOTS | SILHOUETTE | DIAMOND | UPLOAD
  paramsJson    String   @default("{}")
  paperSizes    String   @default("A4,A5,A6")
  filePath      String?  // relativ zu UPLOAD_DIR
  mimeType      String?
  sharedWithTenant Boolean @default(false) // Benutzer-Upload für Tenant freigeben
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant    Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner     User?                 @relation("TargetOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  settings  TargetTenantSetting[]
  favorites TargetFavorite[]

  @@index([tenantId])
  @@index([ownerUserId])
}

model TargetTenantSetting {
  id       String         @id @default(cuid())
  targetId String
  tenantId String
  hidden   Boolean        @default(false)
  target   TargetTemplate @relation(fields: [targetId], references: [id], onDelete: Cascade)
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([targetId, tenantId])
}

model TargetFavorite {
  id       String         @id @default(cuid())
  userId   String
  targetId String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  target   TargetTemplate @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId])
}
